# ----------------------------------------------------------------------
# Unity Export Targeted Ignore
# ----------------------------------------------------------------------
# Ignore heavy, auto-generated compilation caches
android/unityLibrary/.gradle/
android/unityLibrary/build/

# Ignore heavy raw C++ object compiles and native symbols
android/unityLibrary/symbols/
android/unityLibrary/src/main/jniLibs/
android/unityLibrary/src/main/assets/bin/Data/

# ----------------------------------------------------------------------
# Embedded Unity Source Project Ignore
# ----------------------------------------------------------------------
# Target the massive internal local caches inside your unity folder
unity/riau_heritage_ar/[Ll]ibrary/
unity/riau_heritage_ar/[text]Logs/
unity/riau_heritage_ar/[Uu]ser[Ss]ettings/
unity/riau_heritage_ar/[Oo]bj/
unity/riau_heritage_ar/[Bb]uild/
unity/riau_heritage_ar/[Bb]uilds/
unity/riau_heritage_ar/DerivedData/

# Ignore OS specific clutter inside Unity
unity/riau_heritage_ar/.DS_Store
unity/riau_heritage_ar/*.csproj
unity/riau_heritage_ar/*.sln

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release
